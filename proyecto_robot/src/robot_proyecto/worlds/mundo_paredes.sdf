<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mundo_paredes">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pared Norte -->
    <model name="pared_norte">
      <static>true</static>
      <pose>0 3 1 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 0.2 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 0.2 2</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pared Sur -->
    <model name="pared_sur">
      <static>true</static>
      <pose>0 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 0.2 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 0.2 2</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pared Este -->
    <model name="pared_este">
      <static>true</static>
      <pose>3 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 0.2 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 0.2 2</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pared Oeste -->
    <model name="pared_oeste">
      <static>true</static>
      <pose>-3 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 0.2 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 0.2 2</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
